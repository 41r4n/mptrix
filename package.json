{
  "name": "mptrix",
  "version": "0.9.0",
  "description": "MPTRIX — baixador de MP3/MP4 do YouTube com interface gráfica (wrapper de yt-dlp + ffmpeg)",
  "main": "out/main/index.js",
  "author": "MPTRIX",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win --config",
    "build:icon": "node scripts/build-icon.mjs",
    "postinstall": "electron-builder install-app-deps",
    "confere:quinas": "electron scripts/confere-quinas.cjs",
    "confere:janela": "electron scripts/confere-janela.cjs",
    "confere:motor": "node scripts/confere-motor.mjs",
    "confere:plataforma": "node scripts/confere-plataforma.mjs",
    "confere:atualizacao": "electron scripts/confere-atualizacao.cjs 0.3.9 tem-nova && electron scripts/confere-atualizacao.cjs 0.4.0 em-dia",
    "confere:rodape": "electron scripts/confere-rodape.cjs",
    "confere:celular": "node scripts/confere-celular.mjs",
    "confere:pagina": "node scripts/confere-pagina.mjs",
    "tela:celular": "node scripts/gera-tela-celular.mjs",
    "olha:celular": "electron scripts/olha-celular.cjs",
    "olha:mesa": "electron scripts/olha-mesa.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "essentia.js": "^0.1.3",
    "png-to-ico": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.mptrix.app",
    "productName": "MPTRIX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/lexico",
        "to": "lexico",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "release/MPTRIX-celular.apk",
        "to": "MPTRIX-celular.apk"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MPTRIX"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "41r4n",
        "repo": "mptrix"
      }
    ]
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/41r4n/mptrix.git"
  }
}
